# Copy nothing from here into the repo. These are set in the Vercel dashboard
# under Settings > Environment Variables, never in a committed file.

# Required. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.0-flash
GEMINI_MODEL=

# Optional. Comma separated list of origins permitted to call the function.
# Defaults to the GitHub Pages URL plus localhost. Add a custom domain here.
ALLOWED_ORIGINS=
